{
  "appId": "com.collaborative.editor",
  "productName": "Collaborative Text Editor",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "dist-electron/main.js"
  },
  "asar": true,
  "win": {
    "target": ["portable", "nsis"],
    "icon": "build/icon.ico"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "build/icon.icns"
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icon.png"
  },
  "portable": {
    "artifactName": "CollaborativeEditor.exe"
  }
} 