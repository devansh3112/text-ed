{
  "name": "collaborative-text-editor",
  "version": "1.0.0",
  "description": "A collaborative text editor with screen-share protection",
  "type": "module",
  "main": "server.cjs",
  "scripts": {
    "start": "node server.cjs",
    "build": "tsc && vite build && npm run build:electron",
    "build:electron": "tsc --project electron/tsconfig.json",
    "dev": "nodemon server.cjs",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview",
    "stealth:win": "stealth-run.bat",
    "stealth:mac": "chmod +x stealth-run.sh && ./stealth-run.sh",
    "stealth:linux": "chmod +x stealth-run.sh && ./stealth-run.sh",
    "start:server": "node server.cjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.8.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.26",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": "20.x"
  }
}
